{
  "name": "quantflow-pro-backend",
  "version": "1.0.0",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.all.json",
    "verify": "npm run typecheck && npm test",
    "preview:capture": "tsx tools/preview/capture.ts",
    "preview": "tsx tools/preview/serve.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.43.1",
    "axios": "^1.7.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "flow-engine": "file:../quantflow-modules/flow-engine",
    "helmet": "^7.1.0",
    "socket.io": "^4.7.5",
    "uuid": "^9.0.0",
    "ws": "^8.17.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20",
    "@types/uuid": "^9",
    "@types/ws": "^8.5.10",
    "socket.io-client": "^4.8.3",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.4.5"
  }
}
