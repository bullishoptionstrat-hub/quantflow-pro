{
  // Typechecks the tests, which `tsconfig.json` deliberately excludes because
  // they must not be emitted into dist/. Without this, a test can call a
  // function with the wrong signature and only fail at run time — or, worse,
  // pass for the wrong reason.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "."
  },
  "include": ["src/**/*", "test/**/*"]
}
