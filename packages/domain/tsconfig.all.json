{
  // Typecheck-everything graph. `tsconfig.json` stays the BUILD graph (src only,
  // rootDir src, emits to dist). This adds the tests, which the build config
  // excludes — the same drift gap recorded as docs/FORENSIC_AUDIT.md #17 for
  // the backend. A test that is not typechecked stops being a contract.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "rootDir": ".",
    "types": ["node"]
  },
  "include": ["src/**/*", "test/**/*"],
  "exclude": ["node_modules", "dist"]
}
