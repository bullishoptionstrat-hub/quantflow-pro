# ─── Frontend (Next.js) ────────────────────────────────────────────────────────
# Copy to frontend/.env.local

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_WS_URL=http://localhost:3001

# ─── Backend (Node.js Express) ────────────────────────────────────────────────
# Copy to backend/.env

PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Supabase (service role — server only, never expose to client)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# ── Business mode (data rights) ────────────────────────────────────────────────
# Sets which datasets the rights registry (backend/src/provenance/rights.ts)
# will permit, and it fails CLOSED: unset means PRIVATE_RESEARCH, and a value
# that is not one of the two below throws at startup rather than being guessed.
#
#   PRIVATE_RESEARCH   not sold, not publicly displayed. The default.
#   PUBLIC_COMMERCIAL  refuses every PROHIBITED and UNVERIFIED source outright.
#
# Whatever the mode, only affirmatively PERMITTED sources are written into the
# durable signal history. Today that means Tradier, Polygon, MarketData.app,
# Schwab and Tastytrade — CBOE, OCC, Yahoo and FINRA are refused for
# persistence, and /api/health lists the class of every source under `history.rights`.
# BUSINESS_MODE=PRIVATE_RESEARCH

# ── Core Data Sources ──────────────────────────────────────────────────────────
# TRADIER_TOKEN must be a PRODUCTION token. Sandbox tokens are only valid against
# sandbox.tradier.com and cannot stream production market data — /api/health will
# say so explicitly under `sourceErrors.tradier_token` if a sandbox token is set.
# Without a PRODUCTION token there is no licensed options tape, so the only
# flow the app has is the clearly-flagged simulator — and nothing enters the
# track record, because synthetic signals are excluded from it by construction.
TRADIER_TOKEN=your-tradier-api-token
POLYGON_API_KEY=your-polygon-api-key
ALPHAVANTAGE_API_KEY=your-alphavantage-api-key

# ── Demo mode (optional, OFF by default) ───────────────────────────────────────
# Opens a read-only, unauthenticated look at the terminal via the "Continue as
# Guest" button. BOTH must be set, on their respective services, or the path does
# not exist: the button is not rendered, /demo/enter 404s, the demo cookie is
# ignored, and the backend 401s the demo header.
#   frontend: NEXT_PUBLIC_DEMO_MODE=1     backend: DEMO_MODE=1
# Demo sessions never reach /api/chain or the Firecrawl enrichment endpoints —
# those cost money per call and stay on full auth.
# DEMO_MODE=1
# NEXT_PUBLIC_DEMO_MODE=1

# ── Web Enrichment (optional) ──────────────────────────────────────────────────
# Firecrawl — regulatory (FINRA) page sync and news context for the news panel.
# Optional: leave unset and enrichment reports `disabled` in /api/health while the
# rest of the app runs normally. Credits are metered and fetches happen only when
# a request asks for one, but a busy page still costs credits.
# Sign up: https://www.firecrawl.dev
FIRECRAWL_API_KEY=fc-your-firecrawl-api-key

# ── 13 New Free API Sources ────────────────────────────────────────────────────
# FlashAlpha — GEX / DEX / VEX
# Sign up: https://flashalpha.com
FLASHALPHA_API_KEY=your-flashalpha-api-key

# MarketData.app — Real options chains (OPRA data)
# Sign up: https://app.marketdata.app/register
MARKETDATA_TOKEN=your-marketdata-app-token

# Schwab Developer API — Free with brokerage account
# Register app: https://developer.schwab.com
SCHWAB_APP_KEY=your-schwab-app-key
SCHWAB_APP_SECRET=your-schwab-app-secret
SCHWAB_REFRESH_TOKEN=your-schwab-oauth-refresh-token

# Tastytrade API — Free with account (options chains + flow)
# Docs: https://developer.tastytrade.com
TASTYTRADE_USER=your-tastytrade-username
TASTYTRADE_PASS=your-tastytrade-password

# Twelve Data — Real-time quotes & WebSocket
# Sign up: https://twelvedata.com/signup
TWELVE_DATA_API_KEY=your-twelvedata-api-key

# Financial Modeling Prep — Earnings, insiders, news
# Sign up: https://financialmodelingprep.com/developer/docs
FMP_API_KEY=your-fmp-api-key

# CoinGecko Pro — Crypto prices, global market data
# Sign up: https://www.coingecko.com/en/api/pricing (free demo key available)
COINGECKO_API_KEY=your-coingecko-api-key

# FRED (Federal Reserve) — Macro series (CPI, FFR, PCE, etc.)
# Sign up: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your-fred-api-key

# Reddit API — WSB + options sentiment via PRAW
# Create app: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your-reddit-client-id
REDDIT_CLIENT_SECRET=your-reddit-client-secret
REDDIT_USER_AGENT=QuantFlowPro/1.0 by YourRedditUsername

# NewsAPI — Financial headlines
# Sign up: https://newsapi.org/register
NEWS_API_KEY=your-newsapi-key

# CBOE Data — VIX term structure & put/call ratios (no key needed — public data)
CBOE_ENABLED=true

# Yahoo Finance Fallback — Quote & option flow scraping (no key needed)
YAHOO_ENABLED=true

# Stooq Fallback — Futures, indices, yields CSV (no key needed)
STOOQ_ENABLED=true

# ── Upstash Redis (rate limiting + caching) — NOT WIRED UP ────────────────────
# Deliberately left unset. `middleware/rateLimiter.ts` says "replace with
# Upstash Redis in production" and there is no redis client in package.json, so
# the rate limiter is in-memory whether or not these are set. Setting them
# today buys nothing. Uncomment when something reads them.
# UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-token

